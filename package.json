{
  "name": "markdown-data-views",
  "displayName": "Markdown Data Views",
  "description": "Data Views for Markdown",
  "version": "0.0.9",
  "license": "GPL-3.0-only",
  "publisher": "gorootde",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.81.0"
  },
  "repository": {
    "url": "https://github.com/MDQL/vscode-extension"
  },
  "categories": [
    "Other",
    "Snippets"
  ],
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "main": "./out/main.js",
  "contributes": {
    "snippets": [
      {
        "language": "markdown",
        "path": "./snippets.json"
      }
    ],
    "configuration": {
      "title": "Markdown Data Views",
      "properties": {
        "markdown-data-views.ignore-pattern": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Glob patterns for files to ignore"
        },
        "markdown-data-views.glob-pattern": {
          "type": "string",
          "default": "**/*.md",
          "description": "Glob pattern for markdown files to index"
        },
        "markdown-data-views.auto-refresh-index": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable auto refresh of database index"
        },
        "markdown-data-views.log-level": {
          "type": "string",
          "default": "debug",
          "description": "Log level for the extension"
        },
        "markdown-data-views.dataSources": {
          "type": "array",
          "default": [],
          "description": "Configure custom data sources (CSV, Parquet, S3)",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "Unique identifier for the data source"
              },
              "type": {
                "type": "string",
                "enum": ["csv", "parquet", "s3"],
                "description": "Type of data source"
              },
              "label": {
                "type": "string",
                "description": "Display name for the data source"
              },
              "path": {
                "type": "string",
                "description": "File path (for csv and parquet types)"
              },
              "bucket": {
                "type": "string",
                "description": "S3 bucket name (for s3 type)"
              },
              "key": {
                "type": "string",
                "description": "S3 object key (for s3 type)"
              },
              "format": {
                "type": "string",
                "enum": ["csv", "parquet"],
                "description": "File format in S3 (for s3 type)"
              },
              "region": {
                "type": "string",
                "description": "AWS region (for s3 type)"
              },
              "delimiter": {
                "type": "string",
                "description": "CSV delimiter (default: ',')"
              },
              "header": {
                "type": "boolean",
                "description": "Whether CSV has header row (default: true)"
              }
            },
            "required": ["id", "type", "label"]
          }
        }
      }
    },
    "markdown.markdownItPlugins": true,
    "commands": [
      {
        "command": "markdown-data-views.refresh-index",
        "title": "Markdown DataViews: Refresh Database Index"
      },
      {
        "command": "markdown-data-views.run-query",
        "title": "Markdown DataViews: Run MDQL Query"
      }
    ],
    "codeLens": {
      "languageIds": [
        "markdown"
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "yarn esbuild-base --minify",
    "esbuild-base": "esbuild ./src/extension.ts --bundle --outfile=out/main.js --external:vscode --format=cjs --platform=node",
    "esbuild": "yarn esbuild-base --sourcemap",
    "esbuild-watch": "yarn esbuild-base --sourcemap --watch",
    "test-compile": "tsc -p ./",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "yarn run compile && yarn run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/markdown-it": "^12.2.3",
    "@types/mocha": "^10.0.1",
    "@types/node": "20.2.5",
    "@types/vscode": "^1.81.0",
    "@typescript-eslint/eslint-plugin": "^5.59.8",
    "@typescript-eslint/parser": "^5.59.8",
    "@vscode/test-electron": "^2.3.2",
    "esbuild": "^0.18.18",
    "eslint": "^8.41.0",
    "mocha": "^10.2.0",
    "typescript": "^5.1.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.958.0",
    "@mdql/mdql": "^0.0.9",
    "csv-parse": "^6.1.0",
    "glob": "^10.3.3",
    "markdown-it": "^13.0.1",
    "parquetjs": "^0.11.2",
    "pino": "^8.15.0"
  }
}
